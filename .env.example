# ─── App ─────────────────────────────────────────────────────
# Public base URL of the application (used for metadata, links, etc.)
NEXT_PUBLIC_APP_URL=https://musafircaffe.com

# ─── API ─────────────────────────────────────────────────────
# Base URL for the backend API consumed through the API client layer
NEXT_PUBLIC_API_BASE_URL=https://musafircaffe.com/api

# ─── Auth (NextAuth.js / Auth.js) ────────────────────────────
# Secret used to encrypt JWTs and cookies (generate with `openssl rand -base64 32`)
AUTH_SECRET=change-me-to-a-random-secret
# Must match the public site URL in production (Hostinger).
AUTH_URL=https://musafircaffe.com
# Required behind Hostinger / CDN reverse proxies.
AUTH_TRUST_HOST=true

# Optional override for bootstrap admin password used by seed / ensure-admin
# Default: Admin@12345 for admin@musafircaffe.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@12345
# Optional dedicated secret for POST /api/admin/bootstrap (falls back to AUTH_SECRET)
ADMIN_BOOTSTRAP_SECRET=

# ─── Database (Prisma / PostgreSQL) ──────────────────────────
# Hostinger Postgres or Supabase connection string used by Auth.js + Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ─── Supabase Storage (media uploads) ────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Google OAuth provider
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
