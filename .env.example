# ─── App ─────────────────────────────────────────────────────
# Public base URL of the application (used for metadata, links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── API ─────────────────────────────────────────────────────
# Base URL for the backend API consumed through the API client layer
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ─── Auth (NextAuth.js / Auth.js) ────────────────────────────
# Secret used to encrypt JWTs and cookies (generate with `openssl rand -base64 32`)
AUTH_SECRET=change-me-to-a-random-secret

# Optional override for bootstrap admin password used by `npm run db:seed`
# Default: Admin@12345 for admin@musafircaffe.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@12345

# ─── Supabase Storage (media uploads) ────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Google OAuth provider
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
