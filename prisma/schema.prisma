generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application roles — Supabase/Postgres enum ready.
enum UserRole {
  traveler
  cafe_owner
  guide_creator
  editor
  moderator
  admin
}

enum ContentStatus {
  draft
  published
  archived
}

enum ReviewTargetType {
  destination
  cafe
  guide
  community
  hotel
  tour
  gear
}

enum BookmarkTargetType {
  destination
  cafe
  guide
  community
}

enum LikeTargetType {
  destination
  cafe
  guide
  community
  comment
}

enum MediaProvider {
  url
  supabase
  local
}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  password                String                   @default("")
  image                   String?
  role                    UserRole                 @default(traveler)
  emailVerified           Boolean                  @default(false)
  tokenVersion            Int                      @default(0)
  bio                     String?
  location                String?
  website                 String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  preferences             Preferences?
  profile                 Profile?
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  reviews                 Review[]                 @relation("ReviewAuthor")
  mediaUploads            MediaAsset[]             @relation("MediaUploader")
  notifications           AppNotification[]
  bookmarks               Bookmark[]
  likes                   Like[]
  followers               Follow[]                 @relation("Following")
  following               Follow[]                 @relation("Follower")
  trips                   Trip[]
  memberships             Membership[]
  comments                Comment[]
  paymentIntents          PaymentIntentRecord[]

  @@index([role])
  @@index([name])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  headline    String?
  avatarUrl   String?
  coverUrl    String?
  socials     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Preferences {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  privacyMode        String   @default("private")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Country {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  code      String?  @unique
  flag      String?
  region    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
  destinations Destination[]
  cafes     Cafe[]

  @@index([name])
}

model City {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  destinations Destination[]
  cafes     Cafe[]

  @@index([countryId])
  @@index([name])
}

/// CMS category taxonomy (destinations, guides, community, etc.)
model Category {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  description  String?
  scope        String        @default("general")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  destinations Destination[]
  cafes        Cafe[]
  guides       Guide[]
  community    CommunityPost[]
  /// Legacy CMS aliases kept for admin compatibility during migration.
  cmsDestinations CmsDestination[]
  cmsCafes        CmsCafe[]
  cmsGuides       CmsGuide[]
  cmsCommunity    CmsCommunityPost[]
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Public production destination catalog (rich payload for UI parity).
model Destination {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  cityId       String?
  city         City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  countryId    String?
  country      Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  countryName  String
  cityName     String
  region       String?
  summary      String
  description  String
  heroImage    String?
  coverImage   String?
  rating       Float         @default(0)
  reviewCount  Int           @default(0)
  status       ContentStatus @default(published)
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags         String[]      @default([])
  searchText   String        @default("")
  /// Full DestinationDetail-compatible document for pixel-perfect UI.
  payload      Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([countryName])
  @@index([cityName])
  @@index([rating])
  @@index([searchText])
}

model Cafe {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  cityId       String?
  city         City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  countryId    String?
  country      Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  countryName  String
  cityName     String
  summary      String
  description  String
  heroImage    String?
  coverImage   String?
  rating       Float         @default(0)
  reviewCount  Int           @default(0)
  status       ContentStatus @default(published)
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags         String[]      @default([])
  amenities    String[]      @default([])
  searchText   String        @default("")
  payload      Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  images       CafeImage[]

  @@index([status])
  @@index([cityName])
  @@index([rating])
  @@index([searchText])
}
